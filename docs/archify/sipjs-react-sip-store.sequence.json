  "cards": [
    {
      "dot": "cyan",
      "title": "regState — единственный флаг",
      "items": [
        "off / ok / fail; отдельного булева флага «зарегистрирован» нет",
        "UNREGISTER не трогает regState — красный тумблер не гаснет сам"
      ]
    },
    {
      "dot": "orange",
      "title": "Продление и переподключение",
      "items": [
        "re-REGISTER до истечения expires шлёт сам sip.js — стор в этом не участвует",
        "потеря регистрации или обрыв WS: onConnectError + attemptReconnection",
        "2 попытки, пауза 4 с; отказ регистрации гасит UserAgent через 3 с"
      ]
    },
    {
      "dot": "amber",
      "title": "Уход со страницы (F5)",
      "items": [
        "пока regState=ok, beforeunload держит диалог браузера",
        "после подтверждения pagehide шлёт REGISTER expires=0 и ждёт ответа не дольше страницы",
        "bfcache (persisted=true) сессию не рвёт"
      ]
    },
    {
      "dot": "emerald",
      "title": "Хранилище",
      "items": [
        "uriWebRtc и callerUserNum пишет phoneStorage при submit",
        "сид среза phoneControlRdcr: uriWebRtc · callerUserNum · useIce",
        "localStorage трогает только services/ — весь HTTP и ключи там же"
      ]
    }
  ]
