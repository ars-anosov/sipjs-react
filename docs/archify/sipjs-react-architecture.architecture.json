  "cards": [
    {
      "dot": "cyan",
      "title": "Слои приложения",
      "items": [
        "components/ — презентация на MUI: sip.js и livekit-client здесь не импортируются",
        "containers/ — useSelector + bindActionCreators; мосты AUTHCTL_ ↔ PHONECTL_ только в AuthContainer",
        "actions/ — thunk: валидация → сервис → dispatch; чужой срез не читается через getState()",
        "services/ + store/ — сервисы, сид preloadedState и инъекция middleware в configureStore"
      ]
    },
    {
      "dot": "emerald",
      "title": "Стартовый экран и владение рендером",
      "items": [
        "на старте displayReg=false: виден AuthLinks; клик открывает PhoneReg модальным Dialog",
        "AuthLinks виден, пока authStatus ≠ success и regState ≠ ok; иконка AD-формы закомментирована",
        "владение по срезу: AuthContainer — AuthLinks/AuthAd/AuthPad, PhoneContainer — PhoneReg/PhonePad/PhoneHistory/PhoneChat"
      ]
    },
    {
      "dot": "violet",
      "title": "Мост AD → SIP и защита сессии",
      "items": [
        "handleAdRegister → adAuth.loginAd → POST uriAdAuth → AUTHCTL_SUBMIT_SUCCESS",
        "тумблер AuthPad трёхпозиционный по regState (off / ok / fail); успех стирает regUserPass из формы",
        "при regState=ok PhoneContainer вешает beforeunload: F5 рвёт SIP-сессию в памяти singleton phoneRuntime"
      ]
    }
  ]
