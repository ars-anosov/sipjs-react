  "cards": [
    {
      "dot": "violet",
      "title": "Namespace-инвариант",
      "items": [
        "authControlActions не диспатчит PHONECTL_, phoneControlActions — AUTHCTL_",
        "чужой срез thunk не читает через getState() — значение приходит аргументом",
        "AuthContainer — единственное место, где мост разрешён"
      ]
    },
    {
      "dot": "emerald",
      "title": "Тумблер AuthPad = regState",
      "items": [
        "off → handleClkRegister, ok → handleClkUnregister, fail → возврат в off",
        "нет отдельного булева флага регистрации — только regState",
        "потеря регистрации форсирует AuthPad, а не форму PhoneReg"
      ]
    }
  ]
